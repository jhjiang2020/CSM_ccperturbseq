+# Optional CSM v1.4 GEX gRNA removal hook. The vendored Parse code remains
+# unchanged unless submit_step1a_gex_array.sh supplies an explicit module path.
+_CSM_GEX_HOOK_MODULE = None
+_CSM_GEX_HOOK_LOAD_ATTEMPTED = False
+
+
+def _csm_load_gex_hook():
+    """Load and preload the environment-gated CSM hook once per process."""
+    global _CSM_GEX_HOOK_MODULE, _CSM_GEX_HOOK_LOAD_ATTEMPTED
+    if _CSM_GEX_HOOK_LOAD_ATTEMPTED:
+        return _CSM_GEX_HOOK_MODULE
+    _CSM_GEX_HOOK_LOAD_ATTEMPTED = True
+
+    hook_path = os.environ.get("CSM_GEX_DECONTAM_HOOK", "")
+    if not hook_path:
+        return None
+    if not os.path.isfile(hook_path):
+        raise RuntimeError(f"CSM GEX decontamination hook not found: {hook_path}")
+
+    spec = importlib.util.spec_from_file_location("csm_gex_grna_preprocess_hook", hook_path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"Cannot load CSM GEX decontamination hook: {hook_path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    module.preload_from_environment()
+    _CSM_GEX_HOOK_MODULE = module
+    return module
+
+
